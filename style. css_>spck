body {
  background-color: white;
  color: black;
  font-family: Arial;
  text-align: center;
  padding: 20px;
}

h1 {
  color: #1a5d1a;
}

.product {
  background-color: #f9f9f9;
  border: 1px solid #ddd;
  padding: 15px;
  margin: 15px auto;
  border-radius: 10px;
  max-width: 300px;
}

button {
  background-color: green;
  color: white;
  padding: 10px 15px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}
